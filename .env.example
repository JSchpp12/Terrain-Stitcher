# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env is git-ignored. It is read by the terrain_stitcher app (the optional
# USGS credentials) and by the VPN Compose stack (the Surfshark/WireGuard
# settings). The no-VPN stack ignores the Surfshark settings.

# --- USGS (optional) -------------------------------------------------------
# Only needed for the USGS ortho source; ArcGIS/elevation work without it.
USGS_APPLICATION_KEY=
USGS_USERNAME=

# --- Surfshark (WireGuard) -------------------------------------------------
# Used by the Gluetun VPN gateway in docker/docker-compose.yml.
# Surfshark dashboard -> VPN -> Manual Setup -> Desktop or mobile -> WireGuard
# -> "I don't have a keypair" -> generate one. The private key and the IPv4
# "Address" from the generated config go here.
WIREGUARD_PRIVATE_KEY=

# The private tunnel IP from the generated config (for example 10.14.0.2/16).
# This belongs to your keypair, not the server.
WIREGUARD_ADDRESSES=

# Which Surfshark endpoint to use. Set exactly ONE of the selectors below;
# hostname is the narrowest. List every hostname Gluetun knows with:
#   docker run --rm qmcgaw/gluetun format-servers -surfshark
SERVER_HOSTNAMES=
# SERVER_CITIES=Denver
# SERVER_COUNTRIES=United States