# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env is git-ignored. It is read by the VPN Compose stack (Surfshark settings)
# and by the terrain_stitcher app (USGS credentials). The no-VPN stack ignores
# the Surfshark settings.

# --- Surfshark (WireGuard) -------------------------------------------------
# Surfshark dashboard -> VPN -> Manual Setup -> Desktop or mobile -> WireGuard
# -> "I don't have a keypair" -> generate one. The private key and the IPv4
# "Address" from the generated config go here.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# --- Which Surfshark endpoint to use --------------------------------------
# Set exactly ONE of the selectors below. Hostname is the narrowest.
# List every hostname Gluetun knows with:
#   docker run --rm qmcgaw/gluetun format-servers -surfshark
SERVER_HOSTNAMES=
# SERVER_CITIES=Denver
# SERVER_COUNTRIES=United States

# How often Gluetun refreshes its built-in server list (default 480h = 20 days).
# UPDATER_PERIOD=480h

# --- USGS (optional) -------------------------------------------------------
# Only needed for the USGS ortho source; ArcGIS/elevation work without it.
USGS_APPLICATION_KEY=
USGS_USERNAME=
