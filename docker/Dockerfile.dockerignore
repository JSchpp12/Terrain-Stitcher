# Dockerfile-specific ignore file (BuildKit looks for
# <Dockerfile>.dockerignore next to the Dockerfile). The build context is the
# repository root, so paths below are relative to it.

# Version control / editor
.git
.gitignore
.vscode

# Python virtualenvs and caches (host-specific)
.venv
.uv-cache
__pycache__
*.py[cod]
.pytest_cache
*.egg-info

# Build artifacts / local data that should not be baked into the image
result/
terrains/
data/
media/
src/tmpDownloads/
weathercams/
*.zip
*.txt

# Secrets / environment files
.env
.env.*

# Docker files themselves (kept out of the build context)
docker/
